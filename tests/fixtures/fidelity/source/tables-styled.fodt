  </style:page-layout>
  <style:style style:name="Tbl" style:family="table"><style:table-properties style:width="17cm" table:align="margins" fo:margin-top="0.2cm" fo:margin-bottom="0.3cm"/></style:style>
  <style:style style:name="TCell" style:family="table-cell"><style:table-cell-properties fo:padding="0.08cm" fo:border="0.5pt solid #000000"/></style:style>
  <style:style style:name="THead" style:family="table-cell"><style:table-cell-properties fo:background-color="#1f3b5c" fo:padding="0.08cm" fo:border="1.5pt solid #000000"/></style:style>
  <style:style style:name="TShade" style:family="table-cell"><style:table-cell-properties fo:background-color="#dce6f2" fo:padding="0.08cm" fo:border="0.5pt solid #000000"/></style:style>
  <style:style style:name="TWarm" style:family="table-cell"><style:table-cell-properties fo:background-color="#f6dfb4" fo:padding="0.08cm" fo:border="0.5pt solid #000000"/></style:style>
  <style:style style:name="TRule" style:family="table-cell"><style:table-cell-properties fo:padding="0.08cm" fo:border-left="none" fo:border-right="none" fo:border-top="none" fo:border-bottom="0.75pt solid #555555"/></style:style>
  <style:style style:name="THeadText" style:family="paragraph" style:parent-style-name="Table_20_Heading"><style:text-properties fo:color="#ffffff"/></style:style><style:style style:name="Inv.0" style:family="table-column"><style:table-column-properties style:column-width="4.25cm"/></style:style><style:style style:name="Inv.1" style:family="table-column"><style:table-column-properties style:column-width="4.25cm"/></style:style><style:style style:name="Inv.2" style:family="table-column"><style:table-column-properties style:column-width="4.25cm"/></style:style><style:style style:name="Inv.3" style:family="table-column"><style:table-column-properties style:column-width="4.25cm"/></style:style><style:style style:name="Rul.0" style:family="table-column"><style:table-column-properties style:column-width="5cm"/></style:style><style:style style:name="Rul.1" style:family="table-column"><style:table-column-properties style:column-width="6cm"/></style:style><style:style style:name="Rul.2" style:family="table-column"><style:table-column-properties style:column-width="6cm"/></style:style></office:automatic-styles>
  <office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles>
  <office:body><office:text><text:p text:style-name="Title">Workshop Inventory</text:p><text:p text:style-name="Text_20_body">Each volunteer described the height of the hedges along the canal using only paper notebooks. The archive keeper catalogued the amount of rain collected in copper gauges without any modern instruments. Every visiting student compared the songs sung at the autumn market according to the old manual.</text:p><table:table table:name="Inventory" table:style-name="Tbl"><table:table-column table:style-name="Inv.0"/><table:table-column table:style-name="Inv.1"/><table:table-column table:style-name="Inv.2"/><table:table-column table:style-name="Inv.3"/>
    <table:table-header-rows><table:table-row><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Item</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Quarter 1</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Quarter 2</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Notes</text:p></table:table-cell></table:table-row></table:table-header-rows>
    <table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Copper gauges</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">12</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">15</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string" table:number-rows-spanned="2"><text:p text:style-name="Table_20_Contents">Two need new seals.</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Lantern glass</text:p></table:table-cell><table:table-cell table:style-name="TWarm" office:value-type="string" table:number-columns-spanned="2"><text:p text:style-name="Table_20_Contents">40 panes in total over both quarters</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
    <table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Rope (metres)</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">320</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">290</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Stored in shed B.</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Heading">Totals</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string" table:number-columns-spanned="3"><text:p text:style-name="Table_20_Contents">All items counted twice by the fictional team.</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
  </table:table><text:p text:style-name="Text_20_body">A small working group questioned the tidal patterns of the northern bay before the season ended. The fictional cooperative mapped the colours of the evening sky over the dunes while the tide was low.</text:p><table:table table:name="Ruled" table:style-name="Tbl"><table:table-column table:style-name="Rul.0"/><table:table-column table:style-name="Rul.1"/><table:table-column table:style-name="Rul.2"/>
    <table:table-row><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Heading">Station</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Heading">Morning reading</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Heading">Evening reading</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">North pier</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">12 mm</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">9 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">Old mill</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">15 mm</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">11 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">Dune path</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">18 mm</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">13 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">Signal hill</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">21 mm</text:p></table:table-cell><table:table-cell table:style-name="TRule" office:value-type="string"><text:p text:style-name="Table_20_Contents">15 mm</text:p></table:table-cell></table:table-row>
  </table:table><text:p text:style-name="Text_20_body">The lighthouse crew measured the weight of the fishing nets after each trip despite the persistent fog. The Brindlemoor committee questioned the amount of rain collected in copper gauges over three consecutive weeks. The survey team described the growth of moss on the old stone walls according to the old manual. The archive keeper recorded the routes taken by the ferry during storms using only paper notebooks.</text:p></office:text></office:body>
</office:document>
