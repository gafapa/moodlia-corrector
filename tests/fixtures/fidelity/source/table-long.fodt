  <office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles>
  <office:body><office:text><text:p text:style-name="Title">Seasonal Observation Log</text:p><text:p text:style-name="Text_20_body">The lighthouse crew compared the routes taken by the ferry during storms while the tide was low. The harbour office recorded the colours of the evening sky over the dunes with remarkable patience.</text:p><table:table table:name="Log" table:style-name="Tbl"><table:table-column table:style-name="Log.0"/><table:table-column table:style-name="Log.1"/><table:table-column table:style-name="Log.2"/><table:table-column table:style-name="Log.3"/>
    <table:table-header-rows><table:table-row><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">No.</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Entry</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Value</text:p></table:table-cell><table:table-cell table:style-name="THead" office:value-type="string"><text:p text:style-name="THeadText">Status</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">1</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Wind log south</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">48.1 units</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">repeated</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">2</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">Tide log east</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">9.6 units</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">checked</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">3</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Lantern log east</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">72.6 units</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">pending</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">4</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">Wind log north</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">55.8 units</text:p></table:table-cell><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">checked</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">5</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Tide log north</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">77.6 units</text:p></table:table-cell><table:table-cell table:style-name="TCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">pending</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TShade" office:value-type="string"><text:p text:style-name="Table_20_Contents">6</text:p></table:table-cell><table:tab